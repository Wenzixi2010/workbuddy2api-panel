# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json
API_KEY.txt

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
!AGENTS.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
# 抓包取证脚本与原始报文（issue #51 等）；结论写进 issue，不进仓库
/capture/
*.zip
server.exe

# 编译产物（16MB 误提交过一次，20261021）
/server
/app.toml

# 前端（React + Vite）
web/node_modules/
web/dist/
# 构建产物由 build.sh 生成并 go:embed；只保留占位文件保证目录存在
# （go:embed all:dist 在目录缺失时是编译期错误，而 git 不跟踪空目录）
internal/panel/dist/*
!internal/panel/dist/.gitkeep-dist

# 本地临时目录（上游参考代码、构建中间产物、远端部署脚本）
/Temp/
